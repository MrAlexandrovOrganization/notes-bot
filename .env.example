# Logging level for all services (debug|info|warn|error). Default: info.
# LOG_LEVEL=info

# Telegram Bot Configuration
BOT_TOKEN=your_bot_token_here
ROOT_ID=your_telegram_id_here

# Database Configuration (REQUIRED)
# These credentials are used by PostgreSQL and notifications service
DB_NAME=notifications
DB_USER=notif
DB_PASSWORD=change_this_password_in_production

# Notes Directory Configuration (REQUIRED)
# Path to your notes directory
#
# For local run: specify full path on your machine
# Example: /home/maxim/Yandex.Disk/notes
#
# For Docker: same path will be automatically mapped to /notes inside container
# (docker-compose.yml handles the path translation)
NOTES_DIR=/path/to/your/notes

# Template Subdirectory (OPTIONAL)
# Relative path from NOTES_DIR to templates folder
# Default: Templates
# TEMPLATE_SUBDIR=Templates

# Настройки pgAdmin (веб-интерфейс для базы данных)
# Доступен по адресу: http://localhost:5050
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=changeme_pgadmin_password

# Grafana
GRAFANA_PASSWORD=changeme_grafana_password

# Search Service Configuration
# Separate Postgres (pgvector) instance dedicated to the vault index.
SEARCH_DB_NAME=search
SEARCH_DB_USER=search
SEARCH_DB_PASSWORD=changeme_search_password
# How often the indexer rewalks the vault.
SEARCH_INDEX_INTERVAL=5m
# Feature layer. Enabled materializations are continuously kept current,
# independently from which product search consumes them.
SEARCH_FEATURE_EMBEDDINGS=true
SEARCH_FEATURE_VECTOR_INDEX=true
# Тег модели в Ollama должен совпадать с тем, что показывает `ollama list`.
# По умолчанию `ollama pull bge-m3:567m`.
SEARCH_EMBED_MODEL=bge-m3:567m
SEARCH_EMBED_DIM=1024
# Сколько заметок с отсутствующей/устаревшей версией индекса обрабатывать за один тик.
# По умолчанию 50, чтобы первичный прогрев не создавал резкий пик CPU и памяти.
# 0 = явно снять ограничение и обработать весь backlog за один проход.
SEARCH_BACKFILL_BATCH_PER_PASS=50

# Profile extraction is the slow background LLM summarization. It is safe to
# leave it off: chunks, FTS, embeddings, Find and Ask continue to work.
SEARCH_FEATURE_PROFILES=false
SEARCH_FEATURE_PROFILE_EMBEDDINGS=false
# Query-time answer generation. This does not enable background profiles.
SEARCH_FEATURE_LLM_GENERATION=true
# A small structured-output model is sufficient for background card extraction.
SEARCH_PROFILE_MODEL=qwen3.5:2b
# Profiles per index tick. 0 drains all pending cards in one pass.
SEARCH_PROFILE_BACKFILL_BATCH_PER_PASS=10
# Product layer. Available values: name, lexical, dense, profiles.
SEARCH_FIND_RETRIEVERS=name,lexical
SEARCH_ASK_RETRIEVERS=lexical,dense
# Model for query planning and final answers.
SEARCH_AGENT_MODEL=qwen2.5:7b
# Maximum plan/search/review rounds per question (1..5).
SEARCH_AGENT_MAX_STEPS=3

# Web Frontend Configuration (REQUIRED — single shared password, same trust
# model as ROOT_ID for the Telegram bot)
WEB_PASSWORD=change_this_password_in_production
# Random secret used only to sign the session cookie (HMAC) — generate once
# with e.g. `openssl rand -hex 32`, never reuse WEB_PASSWORD here.
WEB_SESSION_SECRET=change_this_secret_in_production

# Telegram webhook protection. Required only when WEBHOOK_URL is set.
# Generate with: openssl rand -hex 32
# WEBHOOK_URL=https://bot.example.com/webhook
# TELEGRAM_WEBHOOK_SECRET=replace_with_a_random_secret
