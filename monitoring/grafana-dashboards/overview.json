      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(rpc_server_call_duration_seconds_bucket{project=\"notes-bot\",instance=~\"$instance\",rpc_method!~\"grpc.health.*\"}[$__rate_interval])))",
          "legendFormat": "",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "gRPC p95 latency",
      "type": "stat"
