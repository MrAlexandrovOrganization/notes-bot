{
  "uid": "notes-journal",
  "title": "Notes · Дневник",
  "schemaVersion": 41,
  "tags": [
    "notes-bot",
    "дневник"
  ],
  "editable": true,
  "timezone": "Europe/Moscow",
  "weekStart": "monday",
  "refresh": "",
  "time": {
    "from": "now-3y/d",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "type": "custom",
        "name": "activity",
        "label": "Календарь",
        "query": "Текст : characters,Связи : links,Зал : gym",
        "current": {
          "text": "Текст",
          "value": "characters"
        },
        "multi": false,
        "includeAll": false
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Оценка дня",
      "type": "timeseries",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "notes-journal-postgres"
      },
      "description": "Оценки от 0 до 10. Пустые оценки пропущены. Ноль — выставленная оценка.",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 10
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "notes-journal-postgres"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "refId": "A",
          "rawSql": "SELECT day::timestamp AT TIME ZONE 'Europe/Moscow' AS \"time\", rating AS \"Оценка\"\nFROM journal.daily\nWHERE rating IS NOT NULL AND $__timeFilter(day::timestamp AT TIME ZONE 'Europe/Moscow')\nORDER BY day;"
        }
      ],
      "options": {
        "tooltip": {
          "mode": "single"
        },
        "legend": {
          "showLegend": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 10,
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "light-blue"
          },
          "custom": {
            "drawStyle": "points",
            "showPoints": "always",
            "pointSize": 4
          }
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "title": "Календарь активности",
      "type": "marcusolsson-calendar-panel",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "notes-journal-postgres"
      },
      "description": "Выбери «Текст», «Связи» или «Зал» в фильтре над дашбордом. Чем ярче точка, тем выше значение. Связи — уникальные заметки со ссылкой из дневной заметки или на неё. Для зала берётся дата выполнения, при её отсутствии — дата дневной заметки.",
      "gridPos": {
        "x": 0,
        "y": 10,
        "w": 24,
        "h": 33
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "notes-journal-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "refId": "A",
          "rawSql": "WITH activity AS (\n    SELECT day, characters AS amount, 'симв.' AS unit\n    FROM journal.daily\n    WHERE ${activity:sqlstring} = 'characters'\n    UNION ALL\n    SELECT day, links AS amount, 'связей' AS unit\n    FROM journal.daily\n    WHERE ${activity:sqlstring} = 'links'\n    UNION ALL\n    SELECT day, 1 AS amount, 'Зал' AS unit\n    FROM journal.gym\n    WHERE ${activity:sqlstring} = 'gym'\n), dated AS (\n    SELECT day::timestamp AT TIME ZONE 'Europe/Moscow' AS \"time\", amount, unit\n    FROM activity\n    WHERE amount > 0\n)\nSELECT \"time\",\n    CASE unit WHEN 'Зал' THEN unit ELSE concat(amount, ' ', unit) END AS activity,\n    CASE unit\n        WHEN 'симв.' THEN\n            CASE WHEN amount >= 2000 THEN 4 WHEN amount >= 750 THEN 3 WHEN amount >= 200 THEN 2 ELSE 1 END\n        WHEN 'связей' THEN\n            CASE WHEN amount >= 8 THEN 4 WHEN amount >= 4 THEN 3 WHEN amount >= 2 THEN 2 ELSE 1 END\n        ELSE 4\n    END AS intensity\nFROM dated\nWHERE $__timeFilter(\"time\")\nORDER BY \"time\";"
        }
      ],
      "options": {
        "defaultView": "year",
        "views": [
          "year",
          "month",
          "week"
        ],
        "dateFormat": "inherit",
        "timeRangeType": "default",
        "timeField": "time",
        "textField": "activity",
        "colors": "thresholds",
        "colorField": "intensity",
        "displayFields": [
          "text"
        ],
        "showEventTooltip": true,
        "showMonthTime": false
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#275340",
                "value": null
              },
              {
                "color": "#269060",
                "value": 2
              },
              {
                "color": "#29b979",
                "value": 3
              },
              {
                "color": "#56e8a9",
                "value": 4
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "title": "Оценка и количество символов",
      "type": "xychart",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "notes-journal-postgres"
      },
      "description": "Одна точка — день с оценкой. X — символы, Y — оценка дня.",
      "gridPos": {
        "x": 0,
        "y": 43,
        "w": 12,
        "h": 10
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "notes-journal-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "refId": "A",
          "rawSql": "SELECT characters AS \"Символы\", rating AS \"Оценка\", day::text AS \"Дата\"\nFROM journal.daily\nWHERE rating IS NOT NULL AND $__timeFilter(day::timestamp AT TIME ZONE 'Europe/Moscow')\nORDER BY day;"
        }
      ],
      "options": {
        "mapping": "manual",
        "series": [
          {
            "x": {
              "matcher": {
                "id": "byName",
                "options": "Символы"
              }
            },
            "y": {
              "matcher": {
                "id": "byName",
                "options": "Оценка"
              }
            },
            "frame": {
              "matcher": {
                "id": "byIndex",
                "options": 0
              }
            }
          }
        ],
        "tooltip": {
          "mode": "single"
        },
        "legend": {
          "showLegend": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "light-blue"
          },
          "min": 0,
          "decimals": 0,
          "custom": {
            "show": "points",
            "fillOpacity": 45,
            "pointSize": {
              "fixed": 5
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Символы"
            },
            "properties": [
              {
                "id": "custom.axisLabel",
                "value": "Символы"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Оценка"
            },
            "properties": [
              {
                "id": "max",
                "value": 10
              },
              {
                "id": "custom.axisLabel",
                "value": "Оценка"
              }
            ]
          }
        ]
      },
      "pluginVersion": "12.0.0"
    },
    {
      "id": 4,
      "title": "Оценка и количество связанных заметок",
      "type": "xychart",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "notes-journal-postgres"
      },
      "description": "Одна точка — день с оценкой. X — связи, Y — оценка дня.",
      "gridPos": {
