      "pluginVersion": "12.0.0"
    },
    {
      "id": 5,
      "title": "Корреляция Пирсона",
      "type": "stat",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "notes-journal-postgres"
      },
      "description": "Коэффициент r по дням с оценкой за выбранный период. Рядом размер выборки. Пустое значение — недостаточно точек или одна из величин постоянна.",
      "gridPos": {
        "x": 0,
        "y": 53,
        "w": 24,
        "h": 5
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "notes-journal-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "refId": "A",
          "rawSql": "SELECT count(*) AS \"Дней с оценкой\",\n       round(corr(rating, characters)::numeric, 2) AS \"Оценка и символы\",\n       round(corr(rating, links)::numeric, 2) AS \"Оценка и связи\"\nFROM journal.daily\nWHERE rating IS NOT NULL AND $__timeFilter(day::timestamp AT TIME ZONE 'Europe/Moscow');"
        }
      ],
      "options": {
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value_and_name",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "decimals": 2,
          "noValue": "—"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Дней с оценкой"
            },
            "properties": [
              {
                "id": "decimals",
                "value": 0
              }
            ]
          }
        ]
      }
    },
    {
      "id": 6,
      "title": "Люди в дневнике",
      "type": "nodeGraph",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "notes-journal-postgres"
      },
      "description": "Ребро соединяет людей, на карточки которых есть ссылки в одной дневной заметке. Число на ребре — количество таких дней, число на узле — дни с совместным упоминанием этого человека.",
      "gridPos": {
        "x": 0,
        "y": 58,
        "w": 24,
        "h": 19
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "notes-journal-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "refId": "nodes",
          "rawSql": "WITH people AS (\n    SELECT first_id AS id, first_name AS title, day\n    FROM journal.people_pairs\n    WHERE $__timeFilter(day::timestamp AT TIME ZONE 'Europe/Moscow')\n    UNION ALL\n    SELECT second_id AS id, second_name AS title, day\n    FROM journal.people_pairs\n    WHERE $__timeFilter(day::timestamp AT TIME ZONE 'Europe/Moscow')\n)\nSELECT id, max(title) AS title, count(DISTINCT day) AS mainstat\nFROM people\nGROUP BY id;"
        },
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "notes-journal-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "refId": "edges",
          "rawSql": "SELECT first_id || '-' || second_id AS id,\n       first_id AS source,\n       second_id AS target,\n       count(*) AS mainstat,\n       least(1 + ln(count(*)::double precision), 6) AS thickness\nFROM journal.people_pairs\nWHERE $__timeFilter(day::timestamp AT TIME ZONE 'Europe/Moscow')\nGROUP BY first_id, second_id;"
        }
      ]
    }
  ],
  "version": 2
}
