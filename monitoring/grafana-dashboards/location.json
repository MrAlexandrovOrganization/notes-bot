      "pluginVersion": "12.0.0",
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "$postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "refId": "A",
          "sql": {
            "columns": [
              {
                "parameters": [],
                "type": "function"
              }
            ],
            "groupBy": [
              {
                "property": {
                  "type": "string"
                },
                "type": "groupBy"
              }
            ],
            "limit": 50
          },
          "rawSql": "-- Every hidden location outside enabled exact/radius rules, without proposal thresholds.\n-- Read-only review: a hidden measurement is not proof of a permanently bad coordinate.\nSELECT l.recorded_at AS \"time\", l.id, l.latitude, l.longitude, l.accuracy,\n       l.source::text AS source, l.provider, l.quality_reason,\n       CASE l.quality_reason\n           WHEN '' THEN 'Причина не записана'\n           WHEN 'speed' THEN 'Превышение скорости'\n           WHEN 'corroborated_jump' THEN 'Подтверждённый скачок'\n           WHEN 'extreme_jump' THEN 'Экстремальный скачок'\n           WHEN 'uncertain_jump' THEN 'Неподтверждённый скачок'\n           WHEN 'poor_accuracy' THEN 'Большая погрешность'\n           WHEN 'stale_measurement' THEN 'Запоздалое измерение'\n           WHEN 'duplicate_measurement' THEN 'Повтор измерения'\n           WHEN 'out_of_order_measurement' THEN 'Нарушен порядок измерений'\n           WHEN 'invalid_measurement' THEN 'Некорректное измерение'\n           ELSE l.quality_reason\n       END AS reason\nFROM public.locations l\nWHERE l.hidden\n  AND $__timeFilter(l.recorded_at)\n  AND l.latitude BETWEEN -90 AND 90 AND l.longitude BETWEEN -180 AND 180\n  AND NOT public.location_blacklist_matches(l.latitude, l.longitude)\nORDER BY l.recorded_at DESC, l.id;"
        }
      ],
      "title": "Скрытые точки вне действующего блэклиста",
      "type": "geomap"
    },
