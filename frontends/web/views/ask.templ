package views

type AskData struct {
	Query   string
	Answer  string
	Error   string
	Sources []string
}

templ Ask(d AskData) {
	@Page("Спросить", "ask") {
		<div class="space-y-4">
			<form method="post" action="/ask" class="flex gap-2">
				<input
					type="text"
					name="q"
					value={ d.Query }
					placeholder="что я делал вчера, когда писал про X, какие задачи по Y"
					required
					autofocus
					class="flex-1 rounded border border-slate-300 px-2 py-1 text-sm"
				/>
				<button type="submit" class="rounded bg-slate-900 px-3 py-1.5 text-sm font-medium text-white hover:bg-slate-800">
					Спросить
				</button>
			</form>

			@ErrorBanner(d.Error)

			if d.Answer != "" {
				<div class="rounded-lg border border-slate-200 bg-white p-4">
					<p class="whitespace-pre-wrap text-sm text-slate-800">{ d.Answer }</p>
					if len(d.Sources) > 0 {
						<div class="mt-3 border-t border-slate-100 pt-3">
							<h3 class="mb-1 text-xs font-medium text-slate-500">Источники</h3>
							<ul class="space-y-0.5 text-xs text-slate-500">
								for _, s := range d.Sources {
									<li>• { s }</li>
								}
							</ul>
						</div>
					}
				</div>
			}
		</div>
	}
}
