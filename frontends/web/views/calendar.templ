package views

import "strconv"

type CalendarDay struct {
	Day     int
	Date    string
	HasNote bool
	IsToday bool
}

type CalendarData struct {
	Year      int
	Month     int
	MonthName string
	PrevYear  int
	PrevMonth int
	NextYear  int
	NextMonth int
	Today     string
	Weeks     [][]CalendarDay
}

templ Calendar(d CalendarData) {
	@Page("Календарь", "calendar") {
		<div class="rounded-lg border border-slate-200 bg-white p-4">
			<div class="mb-4 flex items-center justify-between">
				<a href={ templ.URL(calendarURL(d.PrevYear, d.PrevMonth)) } class="rounded px-2 py-1 text-slate-500 hover:bg-slate-100">◀</a>
				<span class="font-medium">{ d.MonthName } { strconv.Itoa(d.Year) }</span>
				<a href={ templ.URL(calendarURL(d.NextYear, d.NextMonth)) } class="rounded px-2 py-1 text-slate-500 hover:bg-slate-100">▶</a>
			</div>
			<div class="grid grid-cols-7 gap-1 text-center text-xs text-slate-400">
				<div>Пн</div><div>Вт</div><div>Ср</div><div>Чт</div><div>Пт</div><div>Сб</div><div>Вс</div>
			</div>
			<div class="mt-1 space-y-1">
				for _, week := range d.Weeks {
					<div class="grid grid-cols-7 gap-1">
						for _, cell := range week {
							@calendarCell(cell)
						}
					</div>
				}
			</div>
			<div class="mt-4 text-center">
				<a href={ templ.URL("/day?date=" + d.Today) } class="text-sm text-slate-500 hover:underline">Сегодня</a>
			</div>
		</div>
	}
}

templ calendarCell(cell CalendarDay) {
	if cell.Day == 0 {
		<div></div>
	} else {
		<a
			href={ templ.URL("/day?date=" + cell.Date) }
			class={ "flex items-center justify-center rounded py-2 text-sm", calendarCellClass(cell) }
		>
			{ strconv.Itoa(cell.Day) }
		</a>
	}
}

func calendarCellClass(cell CalendarDay) string {
	switch {
	case cell.IsToday:
		return "bg-slate-900 text-white font-medium"
	case cell.HasNote:
		return "bg-slate-100 text-slate-900 font-medium hover:bg-slate-200"
	default:
		return "text-slate-400 hover:bg-slate-50"
	}
}

func calendarURL(year, month int) string {
	return "/calendar?year=" + strconv.Itoa(year) + "&month=" + strconv.Itoa(month)
}
