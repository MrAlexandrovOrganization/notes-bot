package views

import "strconv"

templ Login(errMessage string) {
	@LoginPage(errMessage, false, false)
}

templ LoginPage(errMessage string, miniApp, signedIn bool) {
	<!DOCTYPE html>
	<html lang="ru">
		<head>
			@AppHead("Вход")
			if miniApp {
				<script src="https://telegram.org/js/telegram-web-app.js" defer></script>
				<script src="/static/mini.js" defer></script>
			}
		</head>
		<body class="notes-app notes-login">
			<main class="notes-card">
				<img src="/static/notes-icon.png" width="54" height="54" alt=""/>
				<h1 class="notes-title">Notes</h1>
				@ErrorBanner(errMessage)
				if miniApp {
					<p id="mini-login" class="notes-subtle" data-signed-in={ strconv.FormatBool(signedIn) } aria-live="polite"></p>
				}
				<form method="post" action="/login" class="notes-form">
					<label for="password">Пароль Notes</label>
					<input id="password" name="password" type="password" autocomplete="current-password" required/>
					<button class="notes-primary" type="submit">Войти</button>
				</form>
			</main>
		</body>
	</html>
}
