package views

templ Page(title string, active string) {
	<!DOCTYPE html>
	<html lang="ru">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ title } — Заметки</title>
			<link rel="stylesheet" href="/static/tailwind.css"/>
			<script src="/static/htmx.min.js"></script>
		</head>
		<body class="min-h-screen bg-slate-50 text-slate-900">
			<div class="mx-auto flex min-h-screen max-w-3xl flex-col">
				<header class="border-b border-slate-200 bg-white">
					<nav class="mx-auto flex max-w-3xl flex-wrap items-center gap-1 px-4 py-2 text-sm">
						@navLink("/day", "Сегодня", active == "day")
						@navLink("/calendar", "Календарь", active == "calendar")
						@navLink("/reminders", "Напоминания", active == "reminders")
						@navLink("/search", "Поиск", active == "search")
						@navLink("/ask", "Спросить", active == "ask")
						@navLink("/browse", "Обзор", active == "browse")
						@navLink("/smart", "Быстрый ввод", active == "smart")
						<a href="/logout" class="ml-auto rounded px-3 py-1.5 text-slate-500 hover:bg-slate-100">Выйти</a>
					</nav>
				</header>
				<main class="flex-1 px-4 py-6">
					{ children... }
				</main>
			</div>
		</body>
	</html>
}

templ navLink(href, label string, isActive bool) {
	if isActive {
		<a href={ templ.URL(href) } class="rounded bg-slate-900 px-3 py-1.5 font-medium text-white">{ label }</a>
	} else {
		<a href={ templ.URL(href) } class="rounded px-3 py-1.5 text-slate-600 hover:bg-slate-100">{ label }</a>
	}
}

templ ErrorBanner(message string) {
	if message != "" {
		<div class="mb-4 rounded border border-red-300 bg-red-50 px-4 py-2 text-sm text-red-700">
			{ message }
		</div>
	}
}
