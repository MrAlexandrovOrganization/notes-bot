package views

templ AppHead(title string) {
	<meta charset="UTF-8"/>
	<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover"/>
	<meta name="color-scheme" content="light dark"/>
	<meta name="theme-color" media="(prefers-color-scheme: light)" content="#f2f2f7"/>
	<meta name="theme-color" media="(prefers-color-scheme: dark)" content="#141416"/>
	<title>{ title } — Notes</title>
	<link rel="manifest" href="/static/notes.webmanifest"/>
	<link rel="apple-touch-icon" href="/static/notes-icon.png"/>
	<link rel="stylesheet" href="/static/tailwind.css"/>
	<link rel="stylesheet" href="/static/notes.css"/>
	<link rel="stylesheet" href="/static/note-markdown.css"/>
}

templ Page(title string, active string) {
	<!DOCTYPE html>
	<html lang="ru">
		<head>
			@AppHead(title)
			<script src="/static/htmx.min.js" defer></script>
			<script src="/static/notes.js" defer></script>
			<script src="/static/note-drafts.js" defer></script>
		</head>
		<body class="notes-app">
			<div class="notes-shell">
				<header class="notes-toolbar">
					<a class="notes-tool" href="/search" aria-label="Поиск">@Icon("search")</a>
					<details class="notes-tools">
						<summary class="notes-tool" aria-label="Меню">@Icon("menu")</summary>
						<nav class="notes-popover" aria-label="Меню">
							<a href="/browse">Все заметки</a>
							<a href="/calendar">Дневник по датам</a>
							<a href="/ask">Спросить по заметкам</a>
							<a href="/smart">Быстрый ввод</a>
							<a href="/automations">Автоматизации</a>
							<a href="/logout">Выйти</a>
						</nav>
					</details>
				</header>
				<main class="notes-content">
					{ children... }
				</main>
				<div id="form-error" class="notes-error" aria-live="polite"></div>
			</div>
			<nav class="notes-tabs" aria-label="Разделы Notes">
				@tab("/day", "Заметки", "notes", active != "english" && active != "reminders")
				@tab("/english", "Английский", "english", active == "english")
				@tab("/reminders", "Уведомления", "bell", active == "reminders")
			</nav>
		</body>
	</html>
}

templ tab(href, label, icon string, active bool) {
	<a href={ templ.URL(href) } class="notes-tab" if active { aria-current="page" }>
		@Icon(icon)
		<span>{ label }</span>
	</a>
}

templ Icon(name string) {
	<svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
		switch name {
			case "notes":
				<path d="M6 5a2 2 0 0 1 2-2h10v15H8a2 2 0 1 0 0 4h10M6 5v15M10 7h4m-4 4h4m-4 4h3"/>
			case "english":
				<path d="M5 5a2 2 0 0 1 2-2h12v15H7a2 2 0 1 0 0 4h12M5 5v15m4-6 3-7 3 7m-5-2h4"/>
			case "bell":
				<path d="M18 8a6 6 0 0 0-12 0c0 6-3 6-3 8h18c0-2-3-2-3-8m-8 12c0 2 4 2 4 0"/>
			case "search":
				<circle cx="10.5" cy="10.5" r="5.5"/><path d="m15 15 5 5"/>
			case "menu":
				<circle cx="12" cy="12" r="9"/><path d="M7.5 12h.01m4.5 0h.01m4.5 0h.01" stroke-width="2.6"/>
			case "folder":
				<path d="M3 7a2 2 0 0 1 2-2h5l2 2h7a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
			case "calendar":
				<rect x="3" y="5" width="18" height="16" rx="3"/><path d="M3 10h18M8 3v4m8-4v4m-8 7h.1m3.9 0h.1m3.9 0h.1m-8.1 3h.1m3.9 0h.1"/>
			case "plus":
				<path d="M12 5v14M5 12h14"/>
			case "edit":
				<path d="M20 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h7m-2 10 1-4 7-7a2 2 0 0 1 3 3l-7 7z"/>
			case "star":
				<path d="m12 3 2.7 5.7 6.3.9-4.5 4.4 1.1 6.3-5.6-3-5.6 3 1.1-6.3L3 9.6l6.3-.9z"/>
		}
	</svg>
}

templ ErrorBanner(message string) {
	if message != "" {
		<div class="mb-4 rounded border border-red-300 bg-red-50 px-4 py-2 text-sm text-red-700">
			{ message }
		</div>
	}
}

// FormErrorOOB renders an out-of-band swap target for htmx form errors.
// webapp.formError responds with this fragment so validation errors become
// visible even though the request's hx-target is <main>.
templ FormErrorOOB(message string) {
	<div id="form-error" hx-swap-oob="true" class="px-4">
		if message != "" {
			<div class="rounded border border-red-300 bg-red-50 px-4 py-2 text-sm text-red-700">
				{ message }
			</div>
		}
	</div>
}
