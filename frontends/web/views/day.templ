package views

import "strconv"

type TaskData struct {
	Index  int
	Text   string
	Status string
}

type DayData struct {
	Date      string
	DateTitle string
	Today     bool
	Content   string
	Rating    int
	HasRating bool
	Tasks     []TaskData
}

func dayTitle(d DayData) string {
	if d.Today {
		return "Сегодня"
	}
	return "Дневная заметка"
}

templ Day(d DayData) {
	@Page(dayTitle(d), "day") {
		<h1 class="notes-title">{ dayTitle(d) }</h1>
		<div class="notes-date">
			<a href="/calendar" aria-label={ d.DateTitle + ", открыть календарь" }>{ d.DateTitle }</a>
			<details>
				<summary class="notes-pill">
					@Icon("star")
					if d.HasRating {
						{ strconv.Itoa(d.Rating) + "/10" }
					} else {
						Оценить
					}
				</summary>
				<form method="post" action="/day/rating" hx-post="/day/rating" hx-select="main" hx-target="main" hx-swap="outerHTML" class="notes-form">
					<input type="hidden" name="date" value={ d.Date }/>
					<input type="number" name="rating" min="0" max="10" value={ ratingValue(d) } required aria-label="Оценка от 0 до 10"/>
					<button class="notes-primary" type="submit">Сохранить</button>
				</form>
			</details>
		</div>
		<section class="notes-group">
			<h2 class="notes-label">Задачи</h2>
			<div class="notes-card">
				<div data-draft-refresh="tasks">
					for _, task := range d.Tasks {
						@taskRow(d.Date, task)
					}
					if len(d.Tasks) == 0 {
						<p class="notes-row notes-subtle">Пока нет задач</p>
					}
				</div>
				@dayEditor(d.Date, "/day/tasks", "Добавить задачу", "plus", false)
			</div>
		</section>
		<section class="notes-group">
			<h2 class="notes-label">Дневник</h2>
			<div class="notes-card">
				<div data-draft-refresh="note" data-voice-note-content>
					if d.Content == "" {
						<p class="notes-copy notes-subtle">Пока нет записей</p>
					} else {
						@noteMarkdown(d.Content, "Daily/" + d.Date + ".md")
					}
				</div>
				@dayEditor(d.Date, "/day/append", "Добавить запись", "edit", true)
			</div>
		</section>
		<nav class="notes-card notes-group" aria-label="Хранилище">
			<a class="notes-row" href="/browse">@Icon("folder") Все заметки</a>
			<a class="notes-row" href="/calendar">@Icon("calendar") Дневник по датам</a>
		</nav>
	}
}

templ taskRow(date string, task TaskData) {
	<div class={ "notes-task", "notes-task-" + task.Status }>
		<form method="post" action={ templ.URL(taskURL(task.Index, taskToggleAction(task))) } hx-post={ taskURL(task.Index, taskToggleAction(task)) } hx-select="main" hx-target="main" hx-swap="outerHTML">
			<input type="hidden" name="date" value={ date }/>
			<input type="hidden" name="task_text" value={ task.Text }/>
			<button type="submit" class="notes-task-toggle" aria-label={ taskButtonLabel(task) }>
				<span class="notes-task-mark" aria-hidden="true">
					if task.Status == "completed" {
						✓
					} else if task.Status == "rejected" {
						×
					}
				</span>
				<span class="notes-task-text">{ task.Text }</span>
			</button>
		</form>
		<details>
			<summary aria-label={ "Действия с задачей: " + task.Text }>•••</summary>
			<div class="notes-task-menu">
				if task.Status != "pending" {
					@taskAction(date, task, "open", "Открыть")
				}
				if task.Status != "completed" {
					@taskAction(date, task, "accept", "Выполнить")
				}
				if task.Status != "rejected" {
					@taskAction(date, task, "reject", "Отменить")
				}
			</div>
		</details>
	</div>
}

templ taskAction(date string, task TaskData, action, label string) {
	<form method="post" action={ templ.URL(taskURL(task.Index, action)) } hx-post={ taskURL(task.Index, action) } hx-select="main" hx-target="main" hx-swap="outerHTML">
		<input type="hidden" name="date" value={ date }/>
		<input type="hidden" name="task_text" value={ task.Text }/>
		<button class="notes-secondary" type="submit">{ label }</button>
	</form>
}

templ dayEditor(date, action, label, icon string, multiline bool) {
	<details>
		<summary class="notes-row notes-action">@Icon(icon) <span>{ label }</span></summary>
		<form method="post" action={ templ.URL(action) } hx-post={ action } hx-select="main" hx-target="main" hx-swap="outerHTML" class="notes-form" data-note-draft={ dayDraftKind(multiline) }>
			<input type="hidden" name="date" value={ date }/>
			if multiline {
				<textarea name="text" rows="4" required aria-label="Текст записи"></textarea>
			} else {
				<input name="text" type="text" required aria-label="Текст задачи"/>
			}
			<button class="notes-primary" type="submit">Добавить</button>
			<p class="notes-subtle" data-draft-status aria-live="polite" hidden></p>
		</form>
		if multiline {
			@VoiceComposer(date, "")
		}
	</details>
}

func taskURL(index int, action string) string {
	return "/day/tasks/" + strconv.Itoa(index) + "/" + action
}

func dayDraftKind(multiline bool) string {
	if multiline {
		return "day"
	}
	return "task"
}

func taskToggleAction(task TaskData) string {
	if task.Status == "pending" {
		return "accept"
	}
	return "open"
}

func taskButtonLabel(task TaskData) string {
	switch task.Status {
	case "completed":
		return "Открыть выполненную задачу: " + task.Text
	case "rejected":
		return "Открыть отменённую задачу: " + task.Text
	default:
		return "Выполнить задачу: " + task.Text
	}
}

func ratingValue(d DayData) string {
	if !d.HasRating {
		return ""
	}
	return strconv.Itoa(d.Rating)
}
