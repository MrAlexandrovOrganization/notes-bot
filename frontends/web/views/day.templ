package views

import "strconv"

type TaskData struct {
	Index     int
	Text      string
	Completed bool
}

type DayData struct {
	Date      string
	Content   string
	Rating    int
	HasRating bool
	Tasks     []TaskData
}

templ Day(d DayData) {
	@Page("Заметка "+d.Date, "day") {
		<div class="space-y-6">
			<div class="flex items-center justify-between">
				<h1 class="text-xl font-semibold">{ d.Date }</h1>
				<a href="/calendar" class="text-sm text-slate-500 hover:underline">Выбрать дату</a>
			</div>

			@ratingSection(d)
			@tasksSection(d)
			@noteSection(d)
		</div>
	}
}

templ ratingSection(d DayData) {
	<section class="rounded-lg border border-slate-200 bg-white p-4">
		<h2 class="mb-2 text-sm font-medium text-slate-500">Оценка дня</h2>
		<form
			hx-post="/day/rating"
			hx-select="main" hx-target="main"
			hx-swap="outerHTML"
			class="flex items-center gap-2"
		>
			<input type="hidden" name="date" value={ d.Date }/>
			<input
				type="number"
				name="rating"
				min="0"
				max="10"
				value={ ratingValue(d) }
				class="w-20 rounded border border-slate-300 px-2 py-1 text-sm"
			/>
			<button type="submit" class="rounded bg-slate-900 px-3 py-1.5 text-sm font-medium text-white hover:bg-slate-800">
				Сохранить
			</button>
			if !d.HasRating {
				<span class="text-sm text-slate-400">не установлена</span>
			}
		</form>
	</section>
}

func ratingValue(d DayData) string {
	if !d.HasRating {
		return ""
	}
	return strconv.Itoa(d.Rating)
}

templ tasksSection(d DayData) {
	<section class="rounded-lg border border-slate-200 bg-white p-4">
		<h2 class="mb-2 text-sm font-medium text-slate-500">Задачи</h2>
		<ul class="mb-3 space-y-1">
			for _, t := range d.Tasks {
				<li class="flex items-center gap-2">
					<form
						hx-post={ toggleTaskURL(t.Index) }
						hx-select="main" hx-target="main"
						hx-swap="outerHTML"
					>
						<input type="hidden" name="date" value={ d.Date }/>
						<button type="submit" class="flex items-center gap-2 text-left text-sm">
							if t.Completed {
								<span class="text-emerald-600">☑</span>
							} else {
								<span class="text-slate-400">☐</span>
							}
							if t.Completed {
								<span class="text-slate-400 line-through">{ t.Text }</span>
							} else {
								<span>{ t.Text }</span>
							}
						</button>
					</form>
				</li>
			}
			if len(d.Tasks) == 0 {
				<li class="text-sm text-slate-400">Пока нет задач</li>
			}
		</ul>
		<form hx-post="/day/tasks" hx-select="main" hx-target="main" hx-swap="outerHTML" class="flex gap-2">
			<input type="hidden" name="date" value={ d.Date }/>
			<input
				type="text"
				name="text"
				placeholder="Новая задача"
				required
				class="flex-1 rounded border border-slate-300 px-2 py-1 text-sm"
			/>
			<button type="submit" class="rounded bg-slate-900 px-3 py-1.5 text-sm font-medium text-white hover:bg-slate-800">
				Добавить
			</button>
		</form>
	</section>
}

func toggleTaskURL(index int) string {
	return "/day/tasks/" + strconv.Itoa(index) + "/toggle"
}

templ noteSection(d DayData) {
	<section class="rounded-lg border border-slate-200 bg-white p-4">
		<h2 class="mb-2 text-sm font-medium text-slate-500">Заметка</h2>
		<pre class="mb-3 whitespace-pre-wrap break-words text-sm text-slate-800">{ d.Content }</pre>
		<form hx-post="/day/append" hx-select="main" hx-target="main" hx-swap="outerHTML" class="flex gap-2">
			<input type="hidden" name="date" value={ d.Date }/>
			<input
				type="text"
				name="text"
				placeholder="Добавить запись"
				required
				class="flex-1 rounded border border-slate-300 px-2 py-1 text-sm"
			/>
			<button type="submit" class="rounded bg-slate-900 px-3 py-1.5 text-sm font-medium text-white hover:bg-slate-800">
				Добавить
			</button>
		</form>
	</section>
}
