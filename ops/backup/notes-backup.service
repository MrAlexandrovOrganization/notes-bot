[Unit]
Description=Pull private notes vault and databases to ASUS
Wants=network-online.target
After=network-online.target tailscaled.service
StartLimitIntervalSec=3600
StartLimitBurst=3

[Service]
Type=oneshot
User=maxim
Group=maxim
ExecStart=/usr/bin/python3 /home/maxim/.local/lib/notes-backup/notes_backup.py pull
TimeoutStartSec=35min
Restart=on-failure
RestartSec=5min
UMask=0077
Nice=10
IOSchedulingClass=idle
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/maxim/backups/notes-bot
