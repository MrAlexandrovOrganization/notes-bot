[Unit]
Description=Restore notes files and both databases in isolation
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
User=maxim
Group=maxim
ExecStart=/usr/bin/python3 /home/maxim/.local/lib/notes-backup/notes_backup.py verify
TimeoutStartSec=45min
UMask=0077
Nice=10
IOSchedulingClass=idle
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/maxim/backups/notes-bot
