NOTES_ROLE=search-worker
COMPOSE_PROJECT_NAME=notes-search
COMPOSE_FILE=compose/compose.search-worker.yml
SEARCH_DB_NAME=search
SEARCH_DB_USER=search
SEARCH_DB_PASSWORD=replace-with-the-existing-search-password
NOTES_SEARCH_POSTGRES_IMAGE=pgvector/pgvector@sha256:replace-with-source-digest
SEARCH_TAILNET_AUTH_FILE=/home/user/.config/notes-search/tailnet-auth
HEADSCALE_URL=https://headscale.example.invalid
SEARCH_ROUTER_ADDRESS=replace-with-application-tailnet-ipv4
SEARCH_SNAPSHOT_DIR=/home/user/.local/share/notes-search
NOTES_VAULT_UID=1000
NOTES_VAULT_GID=1000
NOTES_LLM_HOST=replace-with-the-existing-model-server
NOTES_LLM_PORT=11434
SEARCH_INDEX_INTERVAL=5m
SEARCH_EMBED_MODEL=bge-m3:567m
SEARCH_EMBED_DIM=1024
SEARCH_FEATURE_EMBEDDINGS=true
SEARCH_FEATURE_VECTOR_INDEX=true
SEARCH_FEATURE_PROFILES=false
SEARCH_FEATURE_PROFILE_EMBEDDINGS=false
SEARCH_FEATURE_LLM_GENERATION=true
SEARCH_FIND_RETRIEVERS=name,lexical
SEARCH_ASK_RETRIEVERS=lexical,dense
SEARCH_LOG_LEVEL=warn

# Optional: keep embedding and generation models on separate existing servers.
# Append :compose/compose.search-models.yml to COMPOSE_FILE and select this host.
# NOTES_LLM_HOST=search-llm-router
# SEARCH_OLLAMA_NETWORK=ollama-net
# SEARCH_EMBEDDING_ADDRESS=ollama:11434
# SEARCH_GENERATION_ADDRESS=host.docker.internal:11434
# SEARCH_GENERATION_HTTP_HOST=host.docker.internal:11434
